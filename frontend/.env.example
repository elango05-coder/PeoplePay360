# PeoplePay360 Frontend Environment Variables
# Member 2 (Frontend) consumes these public variables.
# Member 1 will provide the live Supabase URL & Anon Key for final integration.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Set to 'true' to use client-side mock service repository (Default for offline demo & testing)
# Set to 'false' to route calls directly through Supabase client
VITE_USE_MOCK=true
